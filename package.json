{
  "name": "commitreport-generator-root",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Development Report Generator monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "test": "pnpm --filter server test",
    "lint": "pnpm --filter server lint && pnpm --filter client lint"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
